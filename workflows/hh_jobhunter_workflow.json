    {
      "parameters": {
        "jsCode": "// Code - Guardrail & Prepare Ollama Body (HeadHunter)\nconst hhData = $input.item.json;\n\n// 1. Извлекаем и нормализуем текст\nconst rawDescription = String(hhData.description || \"\");\nconst cleanDescription = rawDescription.replace(/<[^>]*>?/gm, \" \").replace(/\\s+/g, \" \").trim();\n\nconst fullText = (\n  String(hhData.name || \"\") + \" \" +\n  String(hhData.employer?.name || \"\") + \" \" +\n  cleanDescription\n).toLowerCase();\n\n// 2. ЖЕСТКИЕ КРИТЕРИИ ДЛЯ МГНОВЕННОГО ОТКАЗА (БЕЗ ВЫЗОВА НЕЙРОСЕТИ)\nconst engRegex = /(английск[а-я]\\s+язык|английск[а-я]\\s+реч|уров[а-я]{2,4}\\s+английск|знан[а-я]{2,4}\\s+английск|владен[а-я]{2,4}\\s+английск|разговорн[а-я]{2,4}\\s+английск|делов[а-я]*\\s+английск|english\\s+(level|required|b1|b2|c1|c2|fluent|advanced|intermediate)|\\b(level\\s+)?(b2|c1|c2)\\b(?!\\s*b|\\w)|upper[- ]intermediate|\\badvanced\\s+english\\b|\\bfluent\\s+english\\b)/i;\nconst edtechRegex = /(онлайн[- ]?школ|edtech|skyeng|фоксфорд|tetrica|тетрика|skillbox|geekbrains|нетолог|синерг|лайк|like\\s*центр|interneturok|maximum\\s+education|детск[а-я]*\\s+(центр|клуб|сад|школ|развит|обучен|программ|ai|it)|курс[а-я]*\\s+для\\s+(детей|школьник|подростк|ai|it|программ)|школ[а-я]*\\s+программирован|онлайн[- ]?курс|обучающ[а-я]*\\s+платформ|репетитор|вебинар|марафон|интенсив|инфобиз|наставничеств|коучинг)/i;\n\nconst langs = Array.isArray(hhData.languages) ? hhData.languages : [];\nconst hasEngLang = langs.some(l => l.id === 'eng' || (l.name && l.name.toLowerCase().includes('англ')));\n\n// Проверка формата работы\nconst isExplicitRemote = (hhData.schedule && hhData.schedule.id === 'remote') ||\n  (Array.isArray(hhData.work_format) && hhData.work_format.some(wf => wf.id === 'remote' || wf.name?.toLowerCase().includes('удален'))) ||\n  /100%\\s*удален|полная\\s+удален|только\\s+удален|удаленный\\s+формат/i.test(fullText);\n\nconst isExplicitOffice = /(только\\s+в\\s+офис|работа\\s+в\\s+офисе|офисный\\s+формат|на\\s+территории\\s+работодателя|гибридный\\s+формат|испытательный\\s+срок\\s+в\\s+офисе)/i.test(fullText);\n\n// Проверка зарплаты\nlet explicitLowSalary = false;\nif (hhData.salary && (hhData.salary.currency === 'RUR' || !hhData.salary.currency)) {\n  const toSalary = hhData.salary.to;\n  const fromSalary = hhData.salary.from;\n  if (toSalary && toSalary < 100000 && (!fromSalary || fromSalary < 100000)) {\n    explicitLowSalary = true;\n  }\n}\n\nlet preRejectReason = null;\nif (hasEngLang || engRegex.test(fullText)) {\n  preRejectReason = \"Требуется знание английского языка\";\n} else if (edtechRegex.test(fullText)) {\n  preRejectReason = \"Онлайн-школа / EdTech / Инфобиз\";\n} else if (isExplicitOffice && !isExplicitRemote) {\n  preRejectReason = \"Не удаленка / офис / гибрид\";\n} else if (explicitLowSalary) {\n  preRejectReason = \"Фикс ниже 100 000 ₽\";\n}\n\n// ЕСЛИ СРАБОТАЛ ПРЕДФИЛЬТР - НЕ ВЫЗЫВАЕМ НЕЙРОСЕТЬ\nif (preRejectReason) {\n  return {\n    json: {\n      ...hhData,\n      needs_llm: false,\n      is_relevant: false,\n      reject_reason: preRejectReason,\n      pitch: \"\"\n    }\n  };\n}\n\n// 3. ПОДГОТОВКА ДЛЯ НЕЙРОСЕТИ (ТОЛЬКО ДЛЯ РЕЛЕВАНТНЫХ КАНДИДАТОВ)\nconst salaryInfo = hhData.salary \n  ? ((hhData.salary.from ? 'от ' + hhData.salary.from : '') + (hhData.salary.to ? ' до ' + hhData.salary.to : '') + ' ' + (hhData.salary.currency || 'RUR'))\n  : 'не указана';\n\nconst userContent = [\n  \"ВАКАНСИЯ (HeadHunter):\",\n  \"Должность: \" + (hhData.name || \"\"),\n  \"Компания: \" + (hhData.employer?.name || \"\"),\n  \"Зарплата: \" + salaryInfo,\n  \"Описание: \" + cleanDescription.slice(0, 1500),\n  \"\",\n  \"Оцени вакансию и верни строго JSON на русском языке.\"\n].join(\"\\n\");\n\nconst systemPrompt = `Ты — строгий карьерный эксперт и фильтр вакансий для Дмитрия Федотова (Ex-Yandex, Ex-Ozon Fintech, B2B-продажи, коммерческое руководство).\n\nКРИТЕРИИ ПРИЁМА:\n1. Формат: 100% полная удалёнка (Remote / из дома). Отказ: офис, гибрид.\n2. График: 5/2 (если не указан — считать 5/2). Отказ: сменный, 2/2.\n3. Роль: РОП / Head of Sales / BDM / KAM / Коммерческий директор / B2B-продажи. Линейный менеджер допустим, только если B2B и доход от 100к.\n4. Доход: фикс от 100 000 ₽ или совокупный от 150 000 ₽. Если фикс не указан — принимать руководящие B2B-роли.\n\nСТРОГИЙ ОТКАЗ:\n- Онлайн-школы, EdTech, курсы, репетиторы, инфобиз (причина: \"Онлайн-школа / курсы / EdTech / Инфобиз\")\n- Требование английского языка (любой уровень) (причина: \"Требуется знание английского языка\")\n- Крипта, Web3, трейдинг, гемблинг (причина: \"Крипта / трейдинг / Web3 / гемблинг\")\n- Фикс ниже 100 000 ₽ или только процент (причина: \"Фикс ниже 100 000 ₽\")\n- Офис, гибрид, график не 5/2\n\nСВОДКА ВАКАНСИИ (pitch, заполнять ТОЛЬКО если is_relevant: true, иначе \"\"):\nФормат строго из 3 пунктов в одну строку:\n🏢 Бизнес: [продукт/сфера] | 💰 Доход: [оклад/условия] | 🎯 Задачи: [2-3 главные конкретные обязанности]\n\nОтвечай ТОЛЬКО валидным JSON:\n{\n  \"is_relevant\": true/false,\n  \"reject_reason\": \"причина отказа или null\",\n  \"pitch\": \"текст сводки или пустая строка\"\n}`;\n\nconst body = {\n  model: \"qwen2.5:7b\",\n  format: \"json\",\n  keep_alive: \"1m\",\n  stream: false,\n  options: {\n    num_ctx: 4096,\n    num_predict: 300,\n    temperature: 0.1,\n    num_thread: 4\n  },\n  messages: [\n    { role: \"system\", content: systemPrompt },\n    { role: \"user\", content: userContent }\n  ]\n};\n\nreturn {\n  json: {\n    ...hhData,\n    needs_llm: true,\n    ollamaBody: body\n  }\n};"
      },
