      "id": "49db2c24-223f-4f2c-b609-feea2322a767",
      "name": "Ollama DeepSeek",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let hhData = {};\ntry {\n  hhData = $('HTTP - HH Details').item.json;\n} catch (e) {\n  hhData = {};\n}\n\nconst item = $input.item.json;\nlet raw = \"\";\n\nif (typeof item === \"string\") {\n  raw = item;\n} else if (item.message && typeof item.message.content === \"string\") {\n  raw = item.message.content;\n} else if (typeof item.response === \"string\") {\n  raw = item.response;\n} else if (typeof item.output === \"string\") {\n  raw = item.output;\n} else {\n  raw = JSON.stringify(item);\n}\n\n// Надёжное удаление блока think (включая незакрытый <think>)\nif (raw.includes(\"</think>\")) {\n  raw = raw.split(\"</think>\")[1];\n} else if (raw.includes(\"<think>\")) {\n  raw = raw.replace(/<think>[\\s\\S]*?(?:<\\/think>|$)/gi, \"\");\n}\n\nraw = raw.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n\n// Поиск JSON\nlet parsed = {};\nconst match = raw.match(/\\{[\\s\\S]*\\}/);\nif (match) {\n  try {\n    parsed = JSON.parse(match[0]);\n  } catch (e) {\n    parsed = {};\n  }\n}\n\n// Надёжное извлечение is_relevant с фоллбэком по тексту\nlet isRelevant = false;\nif (typeof parsed.is_relevant === \"boolean\") {\n  isRelevant = parsed.is_relevant;\n} else if (parsed.is_relevant !== undefined && parsed.is_relevant !== null) {\n  isRelevant = String(parsed.is_relevant).toLowerCase() === \"true\";\n} else {\n  const relMatch = raw.match(/\"is_relevant\"\\s*:\\s*(true|false)/i);\n  if (relMatch) {\n    isRelevant = relMatch[1].toLowerCase() === \"true\";\n  }\n}\n\n// Извлечение причины отказа\nlet rejectReason = parsed.reject_reason;\nif (!rejectReason && !isRelevant) {\n  const reasonMatch = raw.match(/\"reject_reason\"\\s*:\\s*\"([^\"]+)\"/i);\n  rejectReason = reasonMatch ? reasonMatch[1] : \"Не соответствует критериям\";\n}\n\n// Извлечение питча\nlet pitch = parsed.pitch || \"\";\nif (!pitch && isRelevant) {\n  const pitchMatch = raw.match(/\"pitch\"\\s*:\\s*\"([^\"]+)\"/i);\n  pitch = pitchMatch ? pitchMatch[1] : \"\";\n}\n\n// Очистка питча от шаблонного мусора\npitch = pitch.replace(/^(Здравствуйте|Добрый день)[,.]?\\s*/i, \"\").trim();\n\n// === АБСОЛЮТНЫЙ GUARDRAIL: ДЕТЕРМИНИРОВАННАЯ ФИЛЬТРАЦИЯ ОНЛАЙН-ШКОЛ И АНГЛИЙСКОГО ===\nif (isRelevant) {\n  const fullText = (\n    String(hhData.name || \"\") + \" \" +\n    String(hhData.employer?.name || \"\") + \" \" +\n    String(hhData.description || \"\") + \" \" +\n    pitch\n  ).toLowerCase();\n\n  // 1. Проверка структурированного поля языков HH\n  const langs = Array.isArray(hhData.languages) ? hhData.languages : [];\n  const hasEngLang = langs.some(l => l.id === 'eng' || (l.name && l.name.toLowerCase().includes('англ')));\n\n  // 2. Регексы на английский язык (требования для работы)\n  const engRegex = /(знани[ея]\\s+английского|уровен[ья]\\s+английского|английск[ийого]{2,4}\\s+язык|разговорн[ыйого]{2,4}\\s+английск|свободн[ыйого]{2,4}\\s+английск|делов[ойого]{2,4}\\s+английск|переговор[ыа-я]*\\s+на\\s+английск|english\\s+(level|required|b1|b2|c1|c2|fluent|advanced|intermediate)|\\b(level\\s+)?(b2|c1|c2)\\b(?!\\s*b|\\w)|upper[- ]intermediate|\\badvanced\\s+english\\b|\\bfluent\\s+english\\b)/i;\n\n  // 3. Регексы на онлайн-школы, EdTech и инфобиз\n  const edtechRegex = /(онлайн[- ]?школ|edtech|skyeng|тетрик|tetrica|skillbox|geekbrains|нетолог|фоксфорд|умскул|интернетурок|interneturok|maximum\\s+education|школ[а-я]*\\s+(дизайна|программирования|вокала|музыки|егэ|огэ|ии|ai|английского)|курс[ыа-я]*\\s+по\\s+(программированию|дизайну|маркетингу|ai|ии|английскому)|продаж[а-я]*\\s+курс|вводн[ыйого]{2,4}\\s+урок|подготовк[а-я]*\\s+к\\s+(егэ|огэ)|репетитор|инфобиз|наставничеств|коучинг)/i;\n\n  if (hasEngLang || engRegex.test(fullText)) {\n    isRelevant = false;\n    rejectReason = \"Требуется знание английского языка\";\n    pitch = \"\";\n  } else if (edtechRegex.test(fullText)) {\n    isRelevant = false;\n    rejectReason = \"Онлайн-школа / EdTech / Инфобиз\";\n    pitch = \"\";\n  }\n}\n\nreturn {\n  json: {\n    ...hhData,\n    is_relevant: isRelevant,\n    reject_reason: isRelevant ? null : (rejectReason || \"Не соответствует критериям\"),\n    pitch: isRelevant ? pitch : \"\"\n  }\n};"
      },
