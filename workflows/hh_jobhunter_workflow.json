    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Code - Parse LLM\nlet hhData = {};\ntry {\n  hhData = $('Prepare Ollama Body').item.json;\n} catch (e) {\n  try {\n    hhData = $('HTTP - HH Details').item.json;\n  } catch (e2) {\n    hhData = {};\n  }\n}\n\nconst item = $input.item.json;\nlet raw = \"\";\n\nif (typeof item === \"string\") {\n  raw = item;\n} else if (item.message && typeof item.message.content === \"string\") {\n  raw = item.message.content;\n} else if (typeof item.response === \"string\") {\n  raw = item.response;\n} else if (typeof item.output === \"string\") {\n  raw = item.output;\n} else {\n  raw = JSON.stringify(item);\n}\n\n// Очистка блока think\nif (raw.includes(\"</think>\")) {\n  raw = raw.split(\"</think>\")[1];\n} else if (raw.includes(\"<think>\")) {\n  raw = raw.replace(/<think>[\\s\\S]*?(?:<\\/think>|$)/gi, \"\");\n}\n\nraw = raw.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n\nlet parsed = {};\nconst match = raw.match(/\\{[\\s\\S]*\\}/);\nif (match) {\n  try {\n    parsed = JSON.parse(match[0]);\n  } catch (e) {\n    parsed = {};\n  }\n}\n\nlet isRelevant = false;\nif (typeof parsed.is_relevant === \"boolean\") {\n  isRelevant = parsed.is_relevant;\n} else if (parsed.is_relevant !== undefined && parsed.is_relevant !== null) {\n  isRelevant = String(parsed.is_relevant).toLowerCase() === \"true\";\n} else {\n  const relMatch = raw.match(/\"is_relevant\"\\s*:\\s*(true|false)/i);\n  if (relMatch) {\n    isRelevant = relMatch[1].toLowerCase() === \"true\";\n  }\n}\n\nlet rejectReason = parsed.reject_reason;\nif (!rejectReason && !isRelevant) {\n  if (item.error) {\n    rejectReason = \"Ошибка LLM: \" + (item.error.message || JSON.stringify(item.error)).slice(0, 80);\n  } else {\n    const reasonMatch = raw.match(/\"reject_reason\"\\s*:\\s*\"([^\"]+)\"/i);\n    rejectReason = reasonMatch ? reasonMatch[1] : \"Не соответствует критериям\";\n  }\n}\n\nlet pitch = parsed.pitch || \"\";\nif (!pitch && isRelevant) {\n  const pitchMatch = raw.match(/\"pitch\"\\s*:\\s*\"([^\"]+)\"/i);\n  pitch = pitchMatch ? pitchMatch[1] : \"\";\n}\n\npitch = pitch.replace(/^(🏢|🎯|💼)[,.]?\\s*/i, \"\").trim();\n\n// ФИНАЛЬНЫЙ GUARDRAIL: защита от галлюцинаций LLM\nif (isRelevant) {\n  const fullText = (\n    String(hhData.name || \"\") + \" \" +\n    String(hhData.employer?.name || \"\") + \" \" +\n    String(hhData.description || \"\") + \" \" +\n    pitch\n  ).toLowerCase();\n\n  const langs = Array.isArray(hhData.languages) ? hhData.languages : [];\n  const hasEngLang = langs.some(l => l.id === 'eng' || (l.name && l.name.toLowerCase().includes('англ')));\n  const engRegex = /(английск[а-я]\\s+язык|английск[а-я]\\s+реч|уров[а-я]{2,4}\\s+английск|знан[а-я]{2,4}\\s+английск|владен[а-я]{2,4}\\s+английск|разговорн[а-я]{2,4}\\s+английск|делов[а-я]*\\s+английск|english\\s+(level|required|b1|b2|c1|c2|fluent|advanced|intermediate)|\\b(level\\s+)?(b2|c1|c2)\\b(?!\\s*b|\\w)|upper[- ]intermediate|\\badvanced\\s+english\\b|\\bfluent\\s+english\\b)/i;\n  const edtechRegex = /(онлайн[- ]?школ|edtech|skyeng|фоксфорд|tetrica|тетрика|skillbox|geekbrains|нетолог|синерг|лайк|like\\s*центр|interneturok|maximum\\s+education|детск[а-я]*\\s+(центр|клуб|сад|школ|развит|обучен|программ|ai|it)|курс[а-я]*\\s+для\\s+(детей|школьник|подростк|ai|it|программ)|школ[а-я]*\\s+программирован|онлайн[- ]?курс|обучающ[а-я]*\\s+платформ|репетитор|вебинар|марафон|интенсив|инфобиз|наставничеств|коучинг)/i;\n\n  if (hasEngLang || engRegex.test(fullText)) {\n    isRelevant = false;\n    rejectReason = \"Требуется знание английского языка\";\n    pitch = \"\";\n  } else if (edtechRegex.test(fullText)) {\n    isRelevant = false;\n    rejectReason = \"Онлайн-школа / EdTech / Инфобиз\";\n    pitch = \"\";\n  }\n}\n\nreturn {\n  json: {\n    ...hhData,\n    is_relevant: isRelevant,\n    reject_reason: isRelevant ? null : (rejectReason || \"Не соответствует критериям\"),\n    pitch: isRelevant ? pitch : \"\"\n  }\n};"
      },
