    {
      "parameters": {
        "jsCode": "// 1. Получаем существующие ID из таблицы\nlet existingIds = new Set();\ntry {\n  const sheetItems = $input.all();\n  existingIds = new Set(\n    sheetItems\n      .map(item => String(item.json.vacancy_id || ''))\n      .filter(id => id.length > 0)\n  );\n  console.log('Уникальных ID в таблице:', existingIds.size);\n} catch (e) {\n  console.log('Ошибка чтения таблицы:', e.message);\n  existingIds = new Set();\n}\n\n// 2. Имена всех 9 нод поиска\nconst searchNodeNames = [\n  'HH - РОП / Head of Sales',\n  'HH - BDM / Развитие бизнеса',\n  'HH - Key Account Enterprise',\n  'HH - FinTech & Banking B2B',\n  'HH - IT & SaaS Enterprise',\n  'HH - Продажи Fintech & SaaS',\n  'HH - Партнёрские продажи',\n  'HH - Ключевые клиенты B2B',\n  'HH - Менеджер по продажам'\n];\n\nlet allRawVacancies = [];\nfor (const name of searchNodeNames) {\n  try {\n    const nodeResults = $(name).all();\n    for (const res of nodeResults) {\n      if (res.json && Array.isArray(res.json.items)) {\n        allRawVacancies.push(...res.json.items);\n      } else if (res.json && res.json.id) {\n        allRawVacancies.push(res.json);\n      }\n    }\n  } catch (err) {\n    console.log(`Нода ${name} еще не выполнена`);\n  }\n}\n\nconsole.log(`Всего собрано вакансий с поисков: ${allRawVacancies.length}`);\n\n// 3. Отбираем только УНИКАЛЬНЫЕ вакансии\nconst uniqueItems = [];\nconst seenInCurrentRun = new Set();\n\nfor (const vacancy of allRawVacancies) {\n  const id = String(vacancy.id || '');\n  if (id && !existingIds.has(id) && !seenInCurrentRun.has(id)) {\n    seenInCurrentRun.add(id);\n    uniqueItems.push({ json: { id: id } });\n  }\n}\n\nconsole.log(`Новых уникальных вакансий: ${uniqueItems.length}`);\nreturn uniqueItems;"
      },
